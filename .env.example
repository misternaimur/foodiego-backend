PORT=8000
# Same Atlas connection string used by the foodiego (Next.js) frontend,
# see foodiego/.env -> MongoDB_URL. Both apps connect to the same
# "FoodBackend" database.
# PORT = "https://foodiego-backend.vercel.app"
MONGODB_URL="mongodb://<user>:<password>@<cluster-host>/?ssl=true&authSource=admin&retryWrites=true&w=majority"
# JWT_SECRET="change-me"

# Used to sign/verify login tokens issued by POST /api/users/login.
# Generate one with: openssl rand -base64 32
